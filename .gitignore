# Third-party trajectories, test logs and patches are never committed.
# Only provenance pointers and small aggregate summaries are.
data/**
!data/README.md
!data/.gitkeep
!data/source_manifest.jsonl
results/**
!results/README.md
!results/.gitkeep

# docs/artifacts/ holds committed, reproducible aggregate summaries only
# (no raw trajectory text). Kept out of results/ so that stays fully ignored.
!docs/artifacts/
!docs/artifacts/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets: this project uses no API keys, and must not start now.
.env
*.key
